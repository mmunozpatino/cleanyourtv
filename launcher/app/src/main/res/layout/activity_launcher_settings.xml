<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/settingsPanel"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="18dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/layout_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/layoutGrid" style="@style/SettingsColumnChoice" android:text="@string/layout_grid" />
            <TextView android:id="@+id/layoutRow" style="@style/SettingsColumnChoice" android:text="@string/layout_row" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/icons_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/iconsColor" style="@style/SettingsColumnChoice" android:text="@string/icons_color" />
            <TextView android:id="@+id/iconsMono" style="@style/SettingsColumnChoice" android:text="@string/icons_mono" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/glass_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/glass0" style="@style/SettingsColumnChoice" android:text="@string/glass_off" />
            <TextView android:id="@+id/glass1" style="@style/SettingsColumnChoice" android:text="@string/glass_clear" />
            <TextView android:id="@+id/glass2" style="@style/SettingsColumnChoice" android:text="@string/glass_medium" />
            <TextView android:id="@+id/glass3" style="@style/SettingsColumnChoice" android:text="@string/glass_dense" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_box_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/appBoxOn" style="@style/SettingsColumnChoice" android:text="@string/on" />
            <TextView android:id="@+id/appBoxOff" style="@style/SettingsColumnChoice" android:text="@string/off" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_box_size_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/boxSize0" style="@style/SettingsColumnChoice" android:text="@string/size_small" />
            <TextView android:id="@+id/boxSize1" style="@style/SettingsColumnChoice" android:text="@string/size_normal" />
            <TextView android:id="@+id/boxSize2" style="@style/SettingsColumnChoice" android:text="@string/size_large" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dock_opacity_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dream_name"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
            <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
            <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/openOnStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
